      "dependencies": [],
      "compatiblePackages": null,
      "options": [
        {
          "key": "versionCode",
          "title": "Version code",
          "description": "The version code to use. (1 ~ 2147483647)",
          "required": true,
          "type": "kotlin.String",
          "default": "2147483647",
          "values": {
            "Lowest": "1",
            "Highest": "2147483647"
          }
        }
      ]
    },
